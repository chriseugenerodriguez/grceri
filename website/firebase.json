{
  "hosting": {
    "site": "grceri-c3702",
    "public": "dist/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [{ "source": "**/*.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
