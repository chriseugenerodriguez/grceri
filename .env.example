SUPABASE_URL=https://your-project.supabase.co
# Server/CLI only. Never place this key in website/src.
SUPABASE_SERVICE_ROLE_KEY=
# Public publishable key (or legacy anon key) for the frontend.
SUPABASE_ANON_KEY=
# CLI database access for migrations and password-based imports.
# Copy host/user/port from Supabase Connect. Session pooler supports IPv4.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
# Optional downloaded Supabase database CA certificate (TLS remains verified).
SUPABASE_DB_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
